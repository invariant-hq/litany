; Every warning but 4 (fragile match, which fires on every `_ ->`, and a
; dependency's variant ends in a catch-all) and the module-style ones: 40, 41,
; 42 (names resolved by type), 44, 45 (an open shadowing), 48 (eliminated
; optional arguments), 67 (a functor parameter its signature leaves unused) and
; 70 (a missing interface, which review holds). Warning 9 makes a new record
; field a compile error wherever a pattern should handle it.

(env
 (_
  (flags
   (:standard -w +a-4-40-41-42-44-45-48-67-70))))

; litany on litany: make test runs this report, and it fails on a finding.
; Fixing is the explicit @lint alias, whose fixes arrive as dune correction
; diffs that dune promote applies. Fixture noise is ringed out in ./litany.

(rule
 (alias runtest)
 (deps
  (alias_rec check))
 (action
  (run litany check)))

(rule
 (alias lint)
 (deps
  (alias_rec check))
 (corrections produce)
 (action
  (run litany check --fix)))

; make coverage. The tests alone, never bench: a benchmark under instrumentation
; measures the counters. Raise the floor with the tests, and never lower it.

(rule
 (alias cover)
 (deps
  (alias_rec test/runtest)
  (universe))
 (action
  (run %{bin:windtrap} coverage --min 89)))
