; bench_traversal is the thumper suite (hermetic fixture,
; committed baseline; thumper is a test dependency); bench_corpus takes a corpus directory
; argument like bench/decode and is run by hand.
;
; The committed traversal.thumper baseline records all three cases — load,
; analyze, and check: analyze pre-pays the demand-gated parse in its setup,
; so only check sees the attribute-lane cost that the budget limits. The
; overhead gate inside bench_traversal.exe re-derives the overhead
; ratio from a quick load/check measurement after the thumper check passes
; (see the header of bench_traversal.ml).

(executable
 (name bench_traversal)
 (modules bench_traversal)
 (libraries compiler-libs.common litany litany_rules thumper))

(executable
 (name bench_corpus)
 (modules bench_corpus)
 (libraries compiler-libs.common litany litany_rules unix))

; A timing, so make bench alone runs it: under load it fails without a
; regression, which no test may do.

(rule
 (alias bench)
 (deps
  traversal.thumper
  fixtures/fix_bench.ml
  fixtures/.fix_bench.objs/byte/fix_bench.cmt
  (glob_files fixtures/.fix_bench.objs/byte/*.cmi))
 (action
  (progn
   (run %{exe:bench_traversal.exe} --quick)
   (diff? traversal.thumper traversal.thumper.corrected))))
