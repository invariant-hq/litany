; The unit-file goldens are hand-crafted bytes: length prefixes computed
; independently of the encoder, so encode is pinned to the format, not to
; itself.

(test
 (name test_unit_file)
 (modules test_unit_file)
 (libraries windtrap litany)
 (deps
  golden_minimal.units
  golden_full.units
  golden_partial.units
  golden_bytes.units))

; Admission (windtrap SKILL.md §6): each rule re-runs one unit
; executable with WINDTRAP_MUTATE=admit, which arms only the faults its
; tests reach and rules every test by name — can each one fail at all?
; One rule per (test) stanza above, one @admit alias over the lot; a
; test stanza added above without a rule here is simply not judged, so
; the two lists are kept in step by eye. The cram suites (test/cli,
; test/rules) observe litany through the binary they spawn, so an
; arming never reaches the code under test and they have nothing to
; admit.
;
;   dune build @admit --instrument-with ppx_windtrap.mutate
;
; The flag is required: this workspace declares no instrumentation, so
; without it every catalogue is empty and the admission seam declines
; by name instead of ruling. The rules live here rather than in
; ../dune, and (alias runtest) replaces the blueprint's per-rule dep
; lists, because the suites read compiled fixture artifacts by
; cwd-relative path and their dep lists live in the stanzas above:
; running the suite first materializes every stanza's fixture closure
; in the build tree — where (sandbox none) lets the admission run see
; it — and admission needs the green suite anyway, since a red dry run
; cannot be judged against. (universe) re-runs the admissions on every
; build, for @cover's and @mutate's reason (../dune).

(rule
 (alias admit)
 (deps
  (universe)
  (sandbox none)
  (alias runtest)
  test_unit.exe)
 (action
  (setenv
   WINDTRAP_MUTATE
   admit
   (run %{exe:test_unit.exe}))))

(rule
 (alias admit)
 (deps
  (universe)
  (sandbox none)
  (alias runtest)
  test_source.exe)
 (action
  (setenv
   WINDTRAP_MUTATE
   admit
   (run %{exe:test_source.exe}))))

