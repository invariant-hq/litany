; Dune's ocamlc-loc parser, vendored for the compiler-renderer golden
; tests: lexer.mll byte-identical to dune's otherlibs/ocamlc-loc/src,
; ocamlc_loc.ml with only the Dyn-dependent printers stripped. TEST-ONLY —
; no public_name, never shipped; the library name is prefixed so it cannot
; collide with another vendor copy of the same source in one workspace.

(library
 (name vendor_ocamlc_loc)
 (modules lexer ocamlc_loc))

(ocamllex lexer)

; Cram-side oracle: parses a compiler-format stream from stdin and prints
; one line per parsed report, so the CLI crams (test/cli/unit.t,
; formats.t) can pin what dune's editor pipeline actually receives.

(executable
 (name parse)
 (modules parse)
 (libraries vendor_ocamlc_loc))
