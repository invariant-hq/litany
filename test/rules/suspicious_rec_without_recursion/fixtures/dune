; Warning 39 (unused rec flag) is exactly what this fixture exhibits —
; under dune's dev profile it is an error, so the fixture libraries opt
; out of it alone. The golden keeps the opt-out too: its fix-refused
; group (comment in the keyword gap) still spells [let rec].

(library
 (name fix_srwr)
 (modules fix_srwr)
 (flags
  (:standard -w -39)))

; The clippy theorem's compile leg, as a plain dune rule: the committed
; .fixed golden's bytes, copied to a module name of their own, build as a
; library; the suite depends on the resulting cmt, so `dune runtest`
; exercises the golden's compilation.

(rule
 (copy fix_srwr.fixed.ml fix_srwr_fixed.ml))

(library
 (name fix_srwr_fixed)
 (modules fix_srwr_fixed)
 (flags
  (:standard -w -39)))
