(library
 (name eio)
 (modules eio))

(library
 (name fix_ssc)
 (modules fix_ssc)
 (libraries eio))

; The clippy theorem's compile leg: the committed golden's bytes, copied
; to a module name of their own, build as a library; the suite depends
; on the resulting cmt, so `dune runtest` exercises the golden's
; compilation. Every fix of this rule is Unsafe (it changes behavior by
; design), so the one golden is the unsafe application.

(rule
 (copy fix_ssc.unsafe.fixed.ml fix_ssc_unsafe_fixed.ml))

(library
 (name fix_ssc_unsafe_fixed)
 (modules fix_ssc_unsafe_fixed)
 (libraries eio))
