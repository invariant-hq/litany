; Keep the result cache inside each cram sandbox: the result cache defaults on
; (XDG/HOME fallback), and a test suite must never write into the user's
; real cache. Relative, so it lands under the command's own cwd; dune and
; the walk adapter both ignore dot-directories.

(env
 (_
  (env-vars
   (LITANY_CACHE_DIR .litany-cache))))

; The launch-catalog cram test: the fixture library's artifacts and sources
; are its deps, so dune builds them before the test runs and they land in
; the sandbox at their tree-relative paths (../fixture from inside check.t).

(cram
 (applies_to check)
 (deps
  %{bin:litany}
  fixture/funcmp.ml
  fixture/length.ml
  fixture/phys.ml
  fixture/warnattr.ml
  fixture/ws.ml
  fixture/fix_rules_cli.ml-gen
  fixture/.fix_rules_cli.objs/byte/fix_rules_cli.cmt
  fixture/.fix_rules_cli.objs/byte/fix_rules_cli__Funcmp.cmt
  fixture/.fix_rules_cli.objs/byte/fix_rules_cli__Length.cmt
  fixture/.fix_rules_cli.objs/byte/fix_rules_cli__Phys.cmt
  fixture/.fix_rules_cli.objs/byte/fix_rules_cli__Warnattr.cmt
  fixture/.fix_rules_cli.objs/byte/fix_rules_cli__Ws.cmt))

