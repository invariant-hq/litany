; The namespace-discipline freeze: the one-library layout
; weakened the engine-unreachable invariant to namespace discipline, so
; runtest asserts that no catalog implementation names a Litany_* module —
; the catalog reaches the SDK through [open Litany] alone. Interface doc
; comments are out of scope: odoc cross-references spell full names.

(rule
 (aliases runtest namespace-discipline)
 (deps
  (:script namespace_discipline.sh)
  (:srcs
   (glob_files ../../lib/rules/*.ml)))
 (action
  (run sh %{script} %{srcs})))
