; Warning 8 (partial match) is exactly what the refutable negatives
; exhibit, and the golden keeps them refused; both libraries opt out of
; it alone.

(library
 (name fix_mtm)
 (modules fix_mtm)
 (flags
  (:standard -w -8)))

; The clippy theorem's compile leg: the committed .fixed golden's bytes,
; copied to a module name of their own, build as a library; the suite
; depends on the resulting cmt, so `dune runtest` exercises the golden's
; compilation.

(rule
 (copy fix_mtm.fixed.ml fix_mtm_fixed.ml))

(library
 (name fix_mtm_fixed)
 (modules fix_mtm_fixed)
 (flags
  (:standard -w -8)))
