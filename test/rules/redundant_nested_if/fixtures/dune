(library
 (name fix_rni)
 (modules fix_rni))

; The clippy theorem's compile leg, as a plain dune rule: the committed
; .fixed golden's bytes, copied to a module name of their own, build as a
; library; the suite depends on the resulting cmt, so `dune runtest`
; exercises the golden's compilation.

(rule
 (copy fix_rni.fixed.ml fix_rni_fixed.ml))

(library
 (name fix_rni_fixed)
 (modules fix_rni_fixed))

; The fixes that name an operator or a module, whose spelling the rule never
; resolved at the fix site, are unsafe: their golden is --fix --unsafe's.

(rule
 (copy fix_rni.unsafe.ml fix_rni_unsafe.ml))

(library
 (name fix_rni_unsafe)
 (modules fix_rni_unsafe))
