(library
 (name fix_mtd)
 (modules fix_mtd)
 (libraries unix))

; The clippy theorem's compile leg: the committed .fixed golden's bytes,
; copied to a module name of their own, build as a library; the suite
; depends on the resulting cmt, so `dune runtest` exercises the golden's
; compilation.

(rule
 (copy fix_mtd.fixed.ml fix_mtd_fixed.ml))

(library
 (name fix_mtd_fixed)
 (modules fix_mtd_fixed)
 (libraries unix))
