; litany's own workspace config. The default set is the gate (runtest);
; the full catalog is the audit spelling, run deliberately:
;   litany check --select all,restriction,nursery
;
; The fixture trees under test/ hold
; deliberately bad code (FIRE-marked rule provocations) and compiled
; goldens; findings there are the suites' subject, never defects. So is
; the documentation's example under examples/inventory/.
(per-path
 (paths test/rules/**/fixtures/** test/rules/fixture/** test/rules/fixture_allow/**
        test/unit/fixtures/**
        bench/**/fixtures/** _build/**/fixtures/**
        examples/inventory/**)
 (ignore all)
 (reason "rule fixtures are deliberate provocations; the suites own them"))

(per-path
 (paths bench/**)
 (ignore suspicious-wall-clock-elapsed)
 (reason "a benchmark reports wall time; the stdlib has no monotonic clock"))
